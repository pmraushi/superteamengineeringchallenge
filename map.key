tunzaa-payment-api/
├── app/
│   ├── __init__.py
│   ├── main.py                # FastAPI app instance
│   ├── config.py              # App config (env vars, settings)
│
│   ├── api/
│   │   ├── __init__.py
│   │   ├── v1/
│   │   │   ├── __init__.py
│   │   │   ├── endpoints/
│   │   │   │   ├── __init__.py
│   │   │   │   ├── auth.py       # JWT login/register
│   │   │   │   ├── payments.py   # Payment plan and savings endpoints
│   │   │   │   └── webhooks.py   # Webhook for payment completed
│   │   │   └── api_router.py     # Collect all routes
│
│   ├── core/
│   │   ├── __init__.py
│   │   ├── security.py        # JWT handling, password hashing
│   │   └── dependencies.py    # Common dependencies (get_db, get_current_user)
│
│   ├── models/
│   │   ├── __init__.py
│   │   ├── user.py            # User model
│   │   └── payment.py         # Payment plan and savings models
│
│   ├── schemas/
│   │   ├── __init__.py
│   │   ├── user.py            # User schemas
│   │   └── payment.py         # Payment plan and savings schemas
│
│   ├── crud/
│   │   ├── __init__.py
│   │   ├── user.py            # User CRUD operations
│   │   └── payment.py         # Payment plan and savings CRUD
│
│   ├── db/
│   │   ├── __init__.py
│   │   ├── session.py         # SQLAlchemy session
│   │   └── base.py            # Base class for models
│
│   ├── tests/
│   │   ├── __init__.py
│   │   ├── test_auth.py       # Test JWT auth
│   │   └── test_payments.py   # Test payment plan and savings
│
├── .env                       # Environment variables
├── requirements.txt           # Dependencies
├── README.md
└── run.sh                     # Run script